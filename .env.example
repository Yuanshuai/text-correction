# ── 部署：服务器上只放一个 docker-compose.yml + 这个 .env 时填 ──
# 两个镜像去哪儿拉。留空就用本机构建出来的同名镜像（本地开发/compose 构建都是这个行为）。
# 服务器部署填镜像仓库里的地址（CI 推上去的那两个 tag，按机器架构选 x86 / arm64），例如：
#   CORRECTION_IMAGE=ghcr.io/yuanshuai/text-correction:standalone-x86
#   CORRECTION_WEB_IMAGE=ghcr.io/yuanshuai/text-correction:standalone-web-x86
# 私有仓库记得先 docker login。
CORRECTION_IMAGE=
CORRECTION_WEB_IMAGE=
# 对外端口：整套服务只有前端这一个口对外（用户页面 + 对外接口都走它），服务器上撞端口就改这一行。
FRONTEND_PORT=18080
# 前端反代等后端回话最多多久：要比「等解析结果」（PARSE2JSON_MAX_WAIT_MIN）加纠错那段时间宽裕，
# 否则大文档会被 nginx 掐成 504。默认 7200s（2 小时）。
# PROXY_TIMEOUT=7200s
# 对外接口（/openapi/contract-audit/web-correct）回的「结果页链接」挂在哪个地址上，例如：
#   PUBLIC_BASE_URL=http://10.0.0.10:18081
# 留空就按这次请求的地址推——外部系统调的是前端那个端口，nginx 把 Host 原样透传过来，
# 推出来的就是用户能打开的那个地址；要是直接打后端端口，推出来的会是后端自己的地址，那种部署就把这里钉死。
PUBLIC_BASE_URL=

# 下面三个只有本机开发那份 docker-compose.override.yml 用（都绑 127.0.0.1，局域网进不来）
BACKEND_PORT=32546
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# 三个官方镜像（mysql / minio / gotenberg）默认从 Docker Hub 拉；那台机器连不上或很慢时，
# 取消注释换成国内镜像源里的同一份镜像（或者换成你们内网 Harbor 的地址）。
# MYSQL_IMAGE=docker.m.daocloud.io/library/mysql:8.0
# MINIO_IMAGE=docker.m.daocloud.io/minio/minio:latest
# GOTENBERG_IMAGE=docker.m.daocloud.io/gotenberg/gotenberg:8

LOG_LEVEL=INFO

# 模型网关：任何 OpenAI 兼容网关都行，填地址、模型名、Bearer token 三项
OPEN_AI_MODEL=qwen3.5-27b
OPEN_BASE_URL=https://llm.example.com/v1
OPEN_AI_TOKEN=sk-your-token

# 核心调优项
MAX_CONCURRENCY=5
LLM_TIMEOUT=60
LLM_TLS_VERIFY=false
# 单次送给模型的分片最多多少字；文本超出会在句末切分后分片并发纠错，不拒绝请求
MAX_TEXT_LENGTH=3000
# PDF 解析开几个进程：按页并行（耗时的活是表格识别），1 表示不并行；不填时按核数取、最多 8
PDF_PARSE_WORKERS=8

# 结果页要展示「原文件的样子」，Word/Excel/PPT 先转成 PDF 再走同一条链路，转换交给外部服务
# （Gotenberg 那套 API：POST {CONVERT_SERVER}/forms/libreoffice/convert，multipart 字段名 files）。
# 不配这个地址就跳过转换，Word 退回「把文字重排出来」那种渲染（没有原版式、也没法在原字上框）。
# （配了下面的外部解析服务就没得退：它只收 PDF，转不出来会直接报错。）
CONVERT_SERVER=
CONVERT_TIMEOUT=120

# ── 外部文档解析（可选：DocParser 的 /async/parse2json，异步提交 + 轮询）──
# 配了地址就默认走它，而且只走它：把「原文 → 段落 + 表格单元格」这段交给外部的版面模型 + OCR
# （扫描件、没有框线的表格比本地 PyMuPDF 强）。出岔子——连不上、服务报错、等超时——直接报错，
# 不退回本地解析：两条路给的结果不一样，悄悄换一条会让人看不懂纠错效果。
# 想跑本地那套就把 PARSE2JSON_BASE_URL 清掉（或者 PARSE2JSON_ENABLED=0）。
# 解析服务是自己按 URL 去下载原文的，所以要给它一个够得着的地址：填一个带 {doc_id} 的模板
# （下面例子是前端那个端口，/api 由 nginx 转到后端的 /document/<id>）。
# 配了 S3_PUBLIC_ENDPOINT 时会优先用对象存储的签名地址，这个模板就可以不填；
# 两样都没有就等于没配全，纠错时会直接报错。
# 这个模板只对「上传上来的文件」用得上：外部系统给的是链接（fileUrl）时，原链接原样转交过去，
# 我们不下载、不转格式（它认不认那个链接是它的事，报错也原样回给调用方）。
# PARSE2JSON_BASE_URL=http://203.0.113.112:38800
# PARSE2JSON_TOKEN=
# PARSE2JSON_ENABLED=1
# PARSE2JSON_FILE_URL=http://10.0.0.10:18081/api/document/{doc_id}
# PARSE2JSON_TIMEOUT=60
# 等解析结果最多多少分钟：大文档（几百页、扫描件）排队 + 识别动辄几十分钟，默认给足 60。
# 老名字 PARSE2JSON_MAX_WAIT（单位是秒）也认，会被折成分钟。
# PARSE2JSON_MAX_WAIT_MIN=60
# PARSE2JSON_POLL_INTERVAL=1
# PARSE2JSON_MAX_PAGES=0
# PARSE2JSON_OCR=false
# 结果页要用的 PDF：只有「不配对象存储」时才落这里，按 TTL 小时保留。
# 配了 S3_* 之后长期那份在对象存储里，本机只放一份解析用的临时文件、请求结束就删。
DOC_CACHE_DIR=
DOC_TTL_HOURS=24

# 纠错记录存哪儿：进 MySQL 之后，结果链接换台机器、换个浏览器也打得开。
# 两种写法都行，MYSQL_DSN 优先：
#   MYSQL_DSN=mysql://用户:密码@主机:3306/库名?charset=utf8mb4
# 或者分开传下面这几个。不配就是老做法：记录只存在浏览器本地，记录接口回 503，
# 前端自动退回本地存储（功能不丢，只是链接不通用）。建表是幂等的，不用手工建。
MYSQL_DSN=
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_RECORD_TABLE=correction_record
MYSQL_POOL_SIZE=2
MYSQL_CONNECT_TIMEOUT=5
MYSQL_TIMEOUT=10

# 结果页要展示的原文（PDF）存哪儿：走对象存储（MinIO / 任意 S3 兼容服务）之后，
# 文件不再随容器走——多副本都取得到，容器重建也不丢。记录里只留对象 key（S3_PREFIX + 文档 id）。
# 不配就是老做法：原文写在本机磁盘，只留 DOC_TTL_HOURS，容器一重建就没了。
#
# S3_ENDPOINT 是后端去连的地址；S3_PUBLIC_ENDPOINT 是「浏览器也能访问到」的地址：
# 配了就让浏览器直连对象存储（后端不搬字节，结果页拿到的是带签名的临时地址），
# 不配就由后端转发（任何网络环境都能跑）。桶不存在会自动建。
S3_ENDPOINT=
S3_PORT=
# 空着按地址里的协议判断（https 就是加密）
S3_USE_SSL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_PREFIX=correction/
S3_PUBLIC_ENDPOINT=
# 直连模式下签名地址的有效期（秒）
S3_PRESIGN_SECONDS=3600
S3_TIMEOUT=30

# 字级工具纠错参数
# 同一批单元最多来回几轮；模型不再调用工具、或某一轮没有任何改动落地时会提前结束
TOOL_MAX_TURNS=0
